        {
          "name": "Lister les datacenters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/datacenters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "datacenters"
              ]
            }
          }
        },
        {
          "name": "Un datacenter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/datacenters/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "datacenters",
                "1"
              ]
            }
          }
        },
        {
          "name": "Lister les techniciens",
          "request": {
            "method": "GET",
            "header": [],
