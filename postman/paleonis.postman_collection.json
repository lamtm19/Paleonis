        {
          "name": "Lister (5 derniers)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/servers/1/evenements?limite=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servers",
                "1",
                "evenements"
              ],
              "query": [
                {
                  "key": "limite",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Lister les alertes sur une période",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/servers/1/evenements?type=alerte&debut=2026-10-20&fin=2026-10-25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servers",
                "1",
                "evenements"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "alerte"
                },
                {
                  "key": "debut",
                  "value": "2026-10-20"
                },
                {
                  "key": "fin",
                  "value": "2026-10-25"
                }
              ]
            }
          }
        },
        {
          "name": "Statistiques par type",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/servers/1/evenements/stats",
